{
  "name": "scribble-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "sync:shared": "node scripts/sync-shared.js",
    "lint:client": "npm run lint --prefix client",
    "lint:server": "npm run lint --prefix server",
    "lint": "npm run lint:client && npm run lint:server",
    "test:client": "npm run test --prefix client",
    "test:server": "npm run test --prefix server",
    "test": "npm run test:client && npm run test:server",
    "test:e2e": "playwright test",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:client",
    "check": "npm run sync:shared && npm run lint && npm run test && npm run test:e2e && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
